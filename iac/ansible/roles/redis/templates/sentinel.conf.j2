bind 0.0.0.0
port 26379
protected-mode no
dir /var/lib/redis
sentinel monitor {{ redis_master_name }} {{ redis_master_ip }} 6379 {{ sentinel_quorum }}
sentinel down-after-milliseconds {{ redis_master_name }} {{ sentinel_down_after_ms }}
sentinel failover-timeout {{ redis_master_name }} {{ sentinel_failover_timeout }}
sentinel parallel-syncs {{ redis_master_name }} 1
{% if redis_requirepass | length > 0 %}
requirepass {{ redis_requirepass }}
sentinel auth-pass {{ redis_master_name }} {{ redis_requirepass }}
{% endif %}
