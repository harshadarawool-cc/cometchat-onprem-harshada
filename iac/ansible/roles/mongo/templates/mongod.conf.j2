storage:
  dbPath: {{ mongo_data_dir }}

systemLog:
  destination: file
  logAppend: true
  path: /var/log/mongodb/mongod.log

processManagement:
  timeZoneInfo: /usr/share/zoneinfo

net:
  port: {{ mongo_port }}
  bindIp: {{ mongo_bind_address }}

security:
  authorization: enabled
  keyFile: {{ mongo_keyfile_path }}

replication:
  replSetName: {{ mongo_replica_set_name }}
