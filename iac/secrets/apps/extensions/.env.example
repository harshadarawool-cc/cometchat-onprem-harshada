# extensions — application environment. Fill every value; this is the .env the extensions pod mounts.
# Also mounts (shared k8s secrets): wildcard-tls (via the nginx sidecar)
# Values REDACTED — keys show what this app requires; supply real values at deploy time.

config_json=
  "COMMON": {
    "NODE_ENV": "staging",
    "AWS_PROFILE": "test",
    "APP_URL": "0.0.0.0",
    "PORT": 5000,
    "REGION": "onprem",
    "CC_REGION": "on-prem",
    "DOMAINS": ["cometchat-cluster-2.in"],
    "DOMAIN_NAME": "cometchat-cluster-2.in",
    "USE_CLUSTER_DOMAIN": 0,
    "CLUSTER_DOMAIN_NAME": "cometchat-cluster-2.in",
    "AWS_ACCOUNT_ID": "",
    "AWS_ACCESS_KEY_ID": "53abb313dd956eaf20a6",
    "AWS_SECRET_ACCESS_KEY": "92ebfb70b0555322ae85ebc0173ca905a60ae36e",
    "AWS_ENDPOINT": "https://media-onprem.cometchat-cluster-2.in",
    "S3_BUCKET": "assets",
    "USE_DB": "MONGO",
    "MONGO_URL": "mongodb://extadmin:REDACTED@10.24.10.11:27017/extensions?replicaSet=rs0&authSource=admin",
    "IS_ON_PREMISE": 1,
    "DYNAMO_DB_BATCH_WRITE_LIMIT": 25,
    "USE_SSL": 0,
    "ENABLE_SIGNED_URLS": false,
    "IGNORE_DIRECTORIES": [
      ".DS_Store",
      "avatar",
      "broadcast",
      "chatwoot",
      "data-masking",
      "disappearing-messages",
      "e2ee",
      "email-notification",
      "email-replies",
      "gifs-gfycat",
      "gifs-giphy",
      "gifs-tenor",
      "human-moderation",
      "image-moderation",
      "intercom",
      "mentions",
      "message-shortcuts",
      "message-translation",
      "pin-message",
      "profanity-filter",
      "push-notification",
      "reactions",
      "reminders",
      "report-message",
      "report-user",
      "rich-media",
      "save-message",
      "sentiment-analysis",
      "slow-mode",
      "smart-reply",
      "sms-notification",
      "stickers-stipop",
      "url-shortener-bitly",
      "url-shortener-tinyurl",
      "virus-malware-scanner",
      "voice-transcription",
      "widget",
      "xss-filter"
    ],
    "KAFKA_GROUP_PREFIX": "EXTENSIONS_",
    "KAFKA_BROKER_LIST": "10.24.10.31:9092",
    "KAFKA_LOG_LEVEL": "NONE",
    "SENTRY_ENABLE": false
  },
  "EXTENSIONS": {
    "document": {
      "PORT": 3019,
      "URL": "https://document-embed-${REGION}.${DOMAIN_NAME}"
    },
    "link-preview": {
      "PORT": 5001,
      "CACHE_ENABLED": false,
      "CACHE_TTL": 60,
      "KAFKA_TOPIC": "internal-events-restapi-messages"
    },
    "polls": {
      "PORT": 3016,
      "V3_ENABLE_KAFKA": 0,
      "V3_ALLOW_JWT_IN_CREATE": 1,
      "V3_ALLOW_AUTH_TOKEN": 1,
      "V3_LAST_X_VOTES": 5,
      "V3_KAFKA_CLIENTID": "polls-v3",
      "V3_KAFKA_SERVER": "10.24.10.31:9092",
      "V3_KAFKA_TOPIC": "internal-polls-v3",
      "V3_KAFKA_CONSUMER_GROUP_ID": "polls_v3",
      "V3_KAFKA_CONSUMER_BATCH_SIZE": 10000,
      "V3_KAFKA_MAX_WAIT_TIME": 10000
    },
    "stickers": {
      "PORT": 2343
    },
    "thumbnail-generator": {
      "PORT": 3015,
      "QUEUE": "https://sqs.${CC_REGION}.amazonaws.com/${AWS_ACCOUNT_ID}/${REGION}-thumbnail-generator-2020-sqs",
      "MAX_RETRIES": 5,
      "CRON_SCHEDULE": "*/25 * * * * *",
      "MAX_DELAY_IN_MS": 180000,
      "USE_SQS": 0
    },
    "whiteboard": {
      "PORT": 3020,
      "URL": "https://whiteboard-embed-${REGION}.${DOMAIN_NAME}"
    }
  }
}
