# visual-chat-builder — application environment. Fill every value; this is the .env the visual-chat-builder pod mounts.
# Also mounts (shared k8s secrets): wildcard-tls (via the nginx sidecar)
# Values REDACTED — keys show what this app requires; supply real values at deploy time.

ADMIN_KEY=
AGENT_BUILDER_LIMIT=2
APP_NAME=
BASIC_AUTH_PASSWORD=
BASIC_AUTH_PASSWORD_ADMIN=
BASIC_AUTH_USERNAME=
BASIC_AUTH_USERNAME_ADMIN=
BUILDER_LIMIT=10
BUILDER_TTL=3600
DATABASE_NAME=
DATABASE_URL=
INTERNAL_HOST_SUBDOMAIN=internal-apivcb
NO_CODE_BUILDER_LIMIT=5
PORT=3000
PUBLIC_HOST_SUBDOMAIN=apivcb
RATE_LIMIT_LIMIT=60
RATE_LIMIT_TTL=60
SENTRY_DSN=
