# websocket — application environment. Fill every value; this is the .env the websocket pod mounts.
# Also mounts (shared k8s secrets): wildcard-tls (via the nginx sidecar)
# Values REDACTED — keys show what this app requires; supply real values at deploy time.

APP_DETAILS=
BASIC_AUTH_CREDS=
CHAT_DB=
CHAT_SERVICE_REDIS_STORAGE=
DIAGNOSTIC_BUFFER_CAPACITY_DEBUG=
DIAGNOSTIC_BUFFER_CAPACITY_ERROR=
DIAGNOSTIC_BUFFER_CAPACITY_INFO=
DIAGNOSTIC_BUFFER_CAPACITY_WARN=
DIAGNOSTIC_CIRCUIT_BREAKER_THRESHOLD=
DIAGNOSTIC_EFS_ID=
DIAGNOSTIC_FLUSH_INTERVAL_SECONDS=
DIAGNOSTIC_LOGGING_APP_CONFIGS=
DIAGNOSTIC_LOG_PATH=/websockets/logs
DIAGNOSTIC_MAX_FILE_SIZE_MB=
DIAGNOSTIC_MAX_PAYLOAD_MB=
DIAGNOSTIC_ROTATION_INTERVAL_MINUTES=
DIAGNOSTIC_S3_BUCKET=
DIAGNOSTIC_S3_PREFIX=diagnostic/
DIAGNOSTIC_SYNC_INTERVAL=
DIAGNOSTIC_SYNC_LOCK_TTL=600
DIAGNOSTIC_TRANSPORT=kafka
KAFKA_EVENT_IN=
KAFKA_EVENT_OUT=
REDIS_PUBSUB_EVENT_IN_CHAT=
REDIS_PUBSUB_EVENT_IN_WS=
REDIS_PUBSUB_EVENT_OUT_CHAT=
REDIS_PUBSUB_EVENT_OUT_WS=
REDIS_STORAGE=
REDIS_STORAGE_KEY_SPACE_NOTIFICATION=
SENTRY=
SETTINGS_API=
