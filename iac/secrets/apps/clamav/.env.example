# clamav — application environment. Fill every value; this is the .env the clamav pod mounts.
# Also mounts (shared k8s secrets): wildcard-tls (via the nginx sidecar)
# Values REDACTED — keys show what this app requires; supply real values at deploy time.

API_KEY=
AWS_REGION=us-east-2
BUCKET_NAME_SECRET_ACCESS_TOKEN_FILE=
CLAMD_HOST=localhost
CLAMD_PORT=3310
DOWNLOAD_TIMEOUT=15000
MAX_DOWNLOAD_SIZE=
NODE_ENV=production
PORT=80
SCAN_TIMEOUT=30000
URL_SPLIT_SECRET_ACCESS_TOKEN=files-onprem.cometchat-cluster-2.in
