# ai-agent-service — application environment. Fill every value; this is the .env the ai-agent-service pod mounts.
# Also mounts (shared k8s secrets): wildcard-tls (via the nginx sidecar)
# Values REDACTED — keys show what this app requires; supply real values at deploy time.

MICROSERVICE_ID=
USERNAME=
PASSWORD=
ADMIN_USERNAME=
ADMIN_PASSWORD=
MONGO_URI=
REDIS_CACHE_URL=redis://10.24.10.21:6379
KAFKA_CLIENT_ID=
KAFKA_BROKERS=
KAFKA_CONSUMER_GROUP_ID=
KAFKA_TOPICS=
KAFKA_MESSAGE_EVENTS_TOPIC=
KAFKA_AGENT_STREAM_TOPIC=
COMETCHAT_REGION_SECRET=
CC_DOMAIN=cometchat-cluster-2.in
REGION=onprem
PORT=4002
NODE_ENV=production
AGENT_CONTEXT_TTL_SECONDS=604800
AGENT_CONTEXT_MESSAGE_LIMIT=10
ENABLE_MESSAGE_VARIABLES=
ENABLE_CONSOLE_LOGS=
LOKI_HOST=http://localhost:3100
LOKI_BATCH_INTERVAL=
LOKI_LOG_LEVEL=
LOKI_ENABLE_BATCHING=
LOKI_CLEAR_ON_ERROR=
SENTRY_ENVIRONMENT=
SENTRY_TRACES_SAMPLE_RATE=
METRICS_USERNAME=
METRICS_PASSWORD=
OTEL_MAX_EXPORT_BATCH_SIZE=250
OTEL_SCHEDULED_DELAY_MILLIS=
OTEL_EXPORT_TIMEOUT_MILLIS=30000
OTEL_MAX_QUEUE_SIZE=
