# service-search — application environment. Fill every value; this is the .env the service-search pod mounts.
# Also mounts (shared k8s secrets): wildcard-tls (via the nginx sidecar)
# Values REDACTED — keys show what this app requires; supply real values at deploy time.

AWS_REGION=us
ELASTICSEARCH_NODE=
KAFKA_BROKER=
KAFKA_CLIENT_ID=
KAFKA_COMMIT_INTERVAL_MS=
KAFKA_GROUP_ID=
KAFKA_GROUP_ID_APP=
KAFKA_GROUP_ID_CONVERSATIONS=
KAFKA_HEARTBEAT_INTERVAL=
KAFKA_MAX_BYTES=
KAFKA_MAX_MESSAGES=
KAFKA_MAX_WAIT_TIME_MS=
KAFKA_MIN_BYTES=
KAFKA_REACTIONS_GROUP_ID=
KAFKA_REBALANCE_TIMEOUT=60000
KAFKA_SESSION_TIMEOUT=10000
KAFKA_TOPIC=
KAFKA_TOPIC_APP=
KAFKA_TOPIC_CONVERSATIONS=
KAFKA_TOPIC_REACTIONS=
KAKA_SEARCH_METRICS_TOPIC=
NODE_ENV=staging
PORT=3000
SEARCH_APP_ACCESSIBLE=
SEARCH_APP_ENABLED=core.advanced.search.enabled
SEARCH_INDEX=
SEARCH_INDEX_APP=
SEARCH_INDEX_REACTIONS=
SENTRY_DSN=
SENTRY_ENABLED=1
SENTRY_ENV=Dev
SERVICE_VERSION=0.0.1
