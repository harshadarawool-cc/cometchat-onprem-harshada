APP_ENV=production
APP_KEY=
APP_REGION=onprem
APP_THROTTLE=1000000
APP_URL=cometchat-cluster-2.in
AUTHTOKEN_THROTTLE=100
CHAT_HOST=websocket-onprem.cometchat-cluster-2.in
CHAT_SECRET=
CLIENT_API_HOST=apiclient-onprem.cometchat-cluster-2.in
CLIENT_API_PREFIX=apiclient
